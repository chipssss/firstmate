<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Copy to ~/Library/LaunchAgents/, replace every /PATH/TO and <...> value, then:
     launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.firstmate.feishu-bridge.plist
     Restart: launchctl kickstart -k gui/$(id -u)/com.firstmate.feishu-bridge -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.firstmate.feishu-bridge</string>
  <key>ProgramArguments</key><array>
    <string>/usr/bin/env</string><string>python3</string><string>-I</string>
    <string>/PATH/TO/firstmate-home/contrib/feishu-bridge/bridge.py</string>
  </array>
  <key>WorkingDirectory</key><string>/PATH/TO/firstmate-home</string>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>FM_HOME</key><string>/PATH/TO/firstmate-home</string>
    <key>FEISHU_PROFILE</key><string>&lt;lark-cli profile of the bot app&gt;</string>
    <key>FEISHU_CAPTAIN_OPEN_ID</key><string>&lt;captain open_id in that app&gt;</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>/PATH/TO/firstmate-home/state/feishu-bridge.log</string>
  <key>StandardErrorPath</key><string>/PATH/TO/firstmate-home/state/feishu-bridge.log</string>
</dict></plist>
